Screen {
    layout: vertical;
    background: #07111f;
    color: #dbeafe;
}

#topbar {
    height: 2;
    padding: 0 1;
    background: #0b172a;
    border-bottom: solid #1e3a5f;
}

#brand {
    width: 20;
    height: 2;
    content-align: left middle;
}

#product-label {
    width: 1fr;
    height: 2;
    color: #64748b;
    content-align: left middle;
}

#mode-indicator {
    width: auto;
    height: 2;
    padding: 0 1;
    color: #93c5fd;
    content-align: right middle;
    text-style: bold;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 30;
    min-width: 22;
    background: #091525;
    border-right: solid #1e3a5f;
}

#library-header {
    height: 2;
    padding: 0 1;
    border-bottom: solid #132946;
}

#library-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    color: #bfdbfe;
    text-style: bold;
}

#library-count {
    width: auto;
    height: 2;
    content-align: right middle;
    color: #64748b;
}

#scope-label {
    height: 1;
    padding: 0 1;
    color: #64748b;
    content-align: left middle;
}

#bundle-tree {
    height: 1fr;
    padding: 0 1 0 0;
    background: #091525;
    scrollbar-color: #1e3a5f;
    scrollbar-color-hover: #2563eb;
    scrollbar-color-active: #3b82f6;
}

#bundle-tree:focus {
    border-left: none;
}

#main {
    width: 1fr;
    background: #07111f;
}

#tabs {
    height: 1fr;
    background: #07111f;
}

TabbedContent ContentSwitcher {
    background: #07111f;
}

Tabs {
    height: 2;
    background: #091525;
    border-bottom: none;
}

Tab {
    color: #64748b;
    padding: 0 1;
}

Tab.-active {
    color: #dbeafe;
    text-style: bold;
}

TabPane {
    padding: 1 2;
    overflow: auto;
    background: #07111f;
}

VimMarkdown {
    border-left: tall transparent;
    scrollbar-color: #1e3a5f;
    scrollbar-color-hover: #2563eb;
    scrollbar-color-active: #3b82f6;
}

VimMarkdown:focus {
    border-left: tall #3b82f6;
}

#chat-drawer {
    width: 54;
    min-width: 40;
    height: 1fr;
    background: #0b172a;
    border-left: heavy #2563eb;
}

#chat-drawer.full-screen {
    layer: overlay;
    dock: right;
    width: 1fr;
    min-width: 1;
    border-left: none;
}

#chat-header {
    height: 2;
    padding: 0 1;
    border-bottom: solid #1e3a5f;
}

#chat-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    text-style: bold;
}

#chat-close-hint {
    width: auto;
    height: 2;
    content-align: right middle;
    color: #64748b;
}

#chat-controls {
    height: 3;
    padding: 0 1;
}

#provider-select {
    width: 1fr;
    margin-right: 1;
}

#mode-select {
    width: 1fr;
}

#chat-transcript {
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#activity {
    height: 1;
    padding: 0 2;
    color: #64748b;
    background: #091525;
}

#chat-input {
    margin: 0 1;
    border: tall #1e3a5f;
}

#chat-input:focus {
    border: tall #3b82f6;
}

#chat-hints {
    height: 1;
    padding: 0 2;
    color: #64748b;
}

#diff {
    height: 12;
    padding: 1;
    overflow: auto;
    border-top: solid #1e3a5f;
}

#apply-button {
    width: 1fr;
    margin: 0 1 1 1;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: #0b172a;
    color: #64748b;
}

#status-bar.chat-mode {
    display: none;
}

/* Narrow terminals use one purposeful pane at a time. */
#body.narrow.library-pane #sidebar {
    display: block;
    width: 1fr;
    min-width: 1;
    border-right: none;
}

#body.narrow.library-pane #main {
    display: none;
}

#body.narrow.content-pane #sidebar {
    display: none;
}

#body.narrow.content-pane #main {
    display: block;
    width: 1fr;
}

/* Chat and the document become a deliberate two-pane workspace on wide screens. */
#body.chat-open #sidebar {
    display: none;
}

#body.chat-open #main {
    display: block;
    width: 1fr;
}

.hidden {
    display: none;
}

SpotlightSearch {
    align: center top;
    padding: 2 2 1 2;
    background: rgba(2, 8, 23, 0.76);
}

#spotlight {
    width: 76;
    max-width: 96%;
    height: auto;
    max-height: 20;
    border: round #3b82f6;
    background: #0b172a;
}

#spotlight-search-row {
    height: 3;
    background: #0f2038;
    border-bottom: solid #1e3a5f;
}

#spotlight-icon {
    width: 4;
    height: 3;
    color: #60a5fa;
    content-align: center middle;
    text-style: bold;
}

#spotlight-query {
    width: 1fr;
    height: 3;
    border: none;
    background: #0f2038;
}

#spotlight-scope {
    width: auto;
    height: 3;
    padding: 0 1;
    color: #93c5fd;
    content-align: right middle;
    text-style: bold;
}

#spotlight-meta {
    height: 1;
    padding: 0 2;
    color: #64748b;
    content-align: left middle;
}

#spotlight-results {
    height: auto;
    min-height: 3;
    max-height: 10;
    margin: 0 1;
    background: #0b172a;
}

#spotlight-results > .option-list--option {
    height: 2;
    padding: 0 1;
}

#spotlight-results > .option-list--option-highlighted {
    background: #1d4ed8;
    color: #eff6ff;
}

#spotlight-empty {
    height: 4;
    padding: 1 2;
    color: #64748b;
    content-align: center middle;
}

#spotlight-hints {
    height: 2;
    padding: 0 2;
    color: #64748b;
    content-align: left middle;
}

KeyboardHelp {
    align: center middle;
    background: rgba(2, 8, 23, 0.82);
}

#keyboard-help {
    width: 72;
    max-width: 94%;
    height: 32;
    max-height: 92%;
    padding: 1 2;
    border: round #3b82f6;
    background: #0b172a;
}
